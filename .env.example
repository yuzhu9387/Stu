# Copy to .env. The local .env is ignored by Git.
# REQUIRED FOR AI: paste your own OpenAI API key below.
# Example format only: sk-proj-your-key-here (never use this sample as a real key).
# One key powers planning, chat adjustments, and recipe text/image import.
OPENAI_API_KEY=
RECIPE_AGENT_LITELLM_CHAT_MODEL=openai/gpt-5.1
RECIPE_AGENT_LITELLM_VISION_MODEL=openai/gpt-5-mini
RECIPE_AGENT_LITELLM_FALLBACK_MODEL=openai/gpt-5-mini
RECIPE_AGENT_LITELLM_EMBEDDING_MODEL=openai/text-embedding-3-small
RECIPE_AGENT_LITELLM_REASONING_EFFORT=high
RECIPE_AGENT_LITELLM_TIMEOUT_SECONDS=90
RECIPE_AGENT_KITCHEN_GENERATION_TIMEOUT_SECONDS=420
RECIPE_AGENT_KITCHEN_GENERATION_REASONING_EFFORT=low
RECIPE_AGENT_LITELLM_MAX_RETRIES=1

# Local development services. Docker overrides database/Redis hosts internally.
RECIPE_AGENT_ENVIRONMENT=development
RECIPE_AGENT_DATABASE_URL=postgresql+asyncpg://recipe:recipe@localhost:55433/recipe
RECIPE_AGENT_REDIS_URL=redis://localhost:6379/0
RECIPE_AGENT_POSTGRES_HOST_PORT=55433
RECIPE_AGENT_WEB_HOST_PORT=13107
RECIPE_AGENT_API_HOST_PORT=8000
RECIPE_AGENT_WEB_ORIGIN=http://localhost:3000
RECIPE_AGENT_DOCKER_WEB_ORIGIN=http://localhost:13107
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Application secrets, separate from the AI key. Generate distinct random values.
# The prepared local .env already contains generated values; no need to fill them.
RECIPE_AGENT_SESSION_SIGNING_KEY=replace-with-a-random-session-secret
RECIPE_AGENT_METRICS_TOKEN=replace-with-a-random-metrics-secret
RECIPE_AGENT_ACTION_SIGNING_KEY=replace-with-a-random-action-secret
RECIPE_AGENT_MAX_REQUEST_BYTES=2097152
RECIPE_AGENT_MAX_UPLOAD_BYTES=10485760
RECIPE_AGENT_REACT_MAX_ITERATIONS=5
RECIPE_AGENT_SUGGESTED_ACTION_LIFETIME_SECONDS=900

# OPTIONAL: Lark integration. Leave disabled for the kitchen Web app.
RECIPE_AGENT_LARK_ENABLED=false
RECIPE_AGENT_LARK_API_BASE_URL=https://open.larksuite.com
RECIPE_AGENT_LARK_APP_ID=
RECIPE_AGENT_LARK_APP_SECRET=
RECIPE_AGENT_LARK_VERIFICATION_TOKEN=
RECIPE_AGENT_LARK_ENCRYPT_KEY=
